(setglobal Ref_spec!
  (let
    (int_ref = (region (makemutable 0 (int) 1))
     var_ref = (region (makemutable 0 65))
     vargen_ref = (region (makemutable 0 65))
     cst_ref = (region (makemutable 0 0))
     gen_ref = (region (makemutable 0 0))
     flt_ref = (region (makemutable 0 (float) 0.)))
    (seq (region (setfield_imm 0 int_ref 2))
      (region (setfield_imm 0 var_ref 66))
      (region (setfield_ptr 0 vargen_ref [0: 66 0]))
      (region (setfield_ptr 0 vargen_ref 67))
      (region (setfield_imm 0 cst_ref 1))
      (region (setfield_ptr 0 gen_ref [0: "foo"]))
      (region (setfield_ptr 0 gen_ref 0))
      (region (setfield_ptr 0 flt_ref 1.))
      (let
        (int_rec = (region (makemutable 0 (*,int) 0 1))
         var_rec = (region (makemutable 0 0 65))
         vargen_rec = (region (makemutable 0 0 65))
         cst_rec = (region (makemutable 0 0 0))
         gen_rec = (region (makemutable 0 0 0))
         flt_rec = (region (makemutable 0 (*,float) 0 0.))
         flt_rec' = (region (makearray[float] 0. 0.)))
        (seq (region (setfield_imm 1 int_rec 2))
          (region (setfield_imm 1 var_rec 66))
          (region (setfield_ptr 1 vargen_rec [0: 66 0]))
          (region (setfield_ptr 1 vargen_rec 67))
          (region (setfield_imm 1 cst_rec 1))
          (region (setfield_ptr 1 gen_rec [0: "foo"]))
          (region (setfield_ptr 1 gen_rec 0))
          (region (setfield_ptr 1 flt_rec 1.))
          (region (setfloatfield 1 flt_rec' 1.))
          (let
            (set_open_poly =
               (function r[->L] y[->L] (region (setfield_ptr 0 r y)))
             set_open_poly =
               (function r[->L] y[->L] (region (setfield_imm 0 r y)))
             set_open_poly =
               (function r[->L] y[->L] (region (setfield_imm 0 r y)))
             set_open_poly =
               (function r[->L] y[->L] (region (setfield_imm 0 r y)))
             set_open_poly =
               (function r[->L] y[->L] (region (setfield_ptr 0 r y)))
             set_open_poly =
               (function r[->L] y[->L] (region (setfield_ptr 0 r y)))
             set_open_poly =
               (function r[->L] y[->L] (region (setfield_ptr 0 r y)))
             set_open_poly = (function r y (region (setfield_ptr 0 r y))))
            (makeblock 0 int_ref var_ref vargen_ref cst_ref gen_ref flt_ref
              int_rec var_rec vargen_rec cst_rec gen_rec flt_rec flt_rec'
              set_open_poly)))))))
